{
    "name": "@former/shared",
    "version": "1.0.0",
    "type": "module",
    "exports": {
        "./schemas": {
            "types": "./dist/schemas/index.d.ts",
            "default": "./dist/schemas/index.js"
        },
        "./db": {
            "types": "./dist/db/index.d.ts",
            "default": "./dist/db/index.js"
        }
    },
    "scripts": {
        "postinstall": "prisma generate --schema=./prisma/schema.prisma && npm run build",
        "build": "tsc --build"
    },
    "dependencies": {
        "@prisma/client": "^7.9.1",
        "prisma": "^7.9.1",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@types/node": "^25.9.5"
    }
}
