{
    "name": "former",
    "private": true,
    "workspaces": [
        "former-backend",
        "former-frontend",
        "packages/shared"
    ],
    "scripts": {
        "build": "npm run build -w former-$BUILD_TARGET",
        "start": "npm run start -w former-$BUILD_TARGET",
        "dev": "npm run dev -w former-backend && npm run dev -w former-frontend"
    },
    "allowScripts": {
        "@prisma/engines@7.9.1": true,
        "bcrypt@6.0.0": true,
        "esbuild@0.28.2": true,
        "prisma@7.9.1": true
    }
}
